# Jenkins Connection
JENKINS_URL=http://localhost:8080
JENKINS_USER=automation-sre
JENKINS_API_TOKEN=change_me_api_token
JENKINS_CLI_JAR=/var/cache/jenkins/war/WEB-INF/lib/cli-2.462.jar
JENKINS_SERVICE_NAME=jenkins
JENKINS_HOME=/var/lib/jenkins

# State & Manifest Paths
STATE_DIR=/var/lib/jenkins-updater
MANIFEST_PATH=/var/lib/jenkins-updater/pending_updates.json

# AWS EBS Rollback Settings
# Se crea un snapshot del volumen root y otro de JENKINS_HOME si está en un volumen dedicado.
# EC2 reemplaza el volumen root desde su snapshot y reinicia automáticamente la instancia.
JENKINS_EBS_DEVICE=/dev/xvdf
IS_DEDICATED_DATA_VOLUME=true

# Alerting & SMTP Settings
COMPANY_DOMAIN=example.com
ALERT_RECIPIENT=sre-team@example.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=change_me_smtp_user
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=jenkins-ops@example.com