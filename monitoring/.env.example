# Grafana Security
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP Settings for Alerts
SMTP_ENABLED=true
SMTP_HOST=smtp.mailgun.org:587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=YourSmtpPasswordHere
SMTP_FROM_ADDRESS=alerts@yourdomain.com
ALERT_EMAIL_TO=ops-team@yourdomain.com

# Prometheus Settings
PROMETHEUS_PORT=9090
PROMETHEUS_TARGETS=10.0.1.50:9100,10.0.1.51:9100
ENVIRONMENT=production